APP_NAME="Cavaliers d'Herouville"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.cavaliers-herouville.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=projet_echec2
DB_USERNAME=projet_echec2_app
DB_PASSWORD=change_me_runtime_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

CACHE_STORE=file
QUEUE_CONNECTION=database

# Choisis un fournisseur expéditeur:
# custom | gmail | ovh | infomaniak | brevo | outlook365
MAIL_PROVIDER=gmail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=adresse_gmail_du_club@gmail.com
MAIL_PASSWORD=change_me_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="adresse_gmail_du_club@gmail.com"
MAIL_FROM_NAME="Cavaliers d'Herouville"

GOOGLE_PLACES_API_KEY=
NEWSLETTER_PUBLIC_BASE_URL=https://www.cavaliers-herouville.fr
NEWSLETTER_CONSENT_SALT=change_me_long_random_value
VISITOR_TRAFFIC_SALT=change_me_long_random_value

SHOP_CARD_PAYMENT_ENABLED=false
SHOP_CARD_PROVIDER=stripe
SHOP_CARD_PROVIDER_LABEL="Prestataire carte bancaire"
SHOP_CARD_CHECKOUT_URL=
