# Oracle 19c runtime (XAMPP / Apache avec extension oci8_19)
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=ORCLPDB1
ORACLE_USER=cavaliers_site
ORACLE_PASSWORD=change_me
ORACLE_CHARSET=AL32UTF8
ORACLE_CLIENT_MIN_VERSION=19

# Optional external API
GOOGLE_PLACES_API_KEY=

# Newsletter / email
MAIL_FROM_ADDRESS=noreply@cavaliers-herouville.fr
MAIL_FROM_NAME=Les Cavaliers d'Herouville
NEWSLETTER_PUBLIC_BASE_URL=http://localhost
NEWSLETTER_CONSENT_SALT=change_me_long_random_value
